extends Node

# Global sound player (autoload "Sfx"). Usage: Sfx.play("shoot")

const SOUNDS = {
	"shoot": preload("res://Audio/shoot.wav"),
	"hit": preload("res://Audio/hit.wav"),
	"explode": preload("res://Audio/explode.wav"),
	"pickup": preload("res://Audio/pickup.wav"),
	"power_up": preload("res://Audio/power_up.wav"),
	"player_hit": preload("res://Audio/player_hit.wav"),
	"enemy_shoot": preload("res://Audio/enemy_shoot.wav"),
	"shockwave": preload("res://Audio/shockwave.wav"),
	"laser": preload("res://Audio/laser.wav"),
	"lightning": preload("res://Audio/lightning.wav"),
	"shield": preload("res://Audio/shield.wav"),
	"siren": preload("res://Audio/siren.wav"),
	"jingle": preload("res://Audio/jingle.wav"),
	"perfect": preload("res://Audio/perfect.wav"),
	"chain_1": preload("res://Audio/chain_1.wav"),
	"chain_2": preload("res://Audio/chain_2.wav"),
	"chain_3": preload("res://Audio/chain_3.wav"),
	"chain_4": preload("res://Audio/chain_4.wav"),
	"shoot_laser": preload("res://Audio/shoot_laser.wav"),
	"shoot_fish": preload("res://Audio/shoot_fish.wav"),
	"weapon_switch": preload("res://Audio/weapon_switch.wav"),
	"armor_ping": preload("res://Audio/armor_ping.wav"),
	"armor_crack": preload("res://Audio/armor_crack.wav"),
	"armor_break": preload("res://Audio/armor_break.wav"),
	"dance": preload("res://Audio/dance.wav"),
	"meow_1": preload("res://Audio/meow_1.wav"),
	"meow_2": preload("res://Audio/meow_2.wav"),
	"meow_3": preload("res://Audio/meow_3.wav"),
	"meow_4": preload("res://Audio/meow_4.wav"),
	"meow_5": preload("res://Audio/meow_5.wav"),
	"mrrp": preload("res://Audio/mrrp.wav"),
	"meow_growl": preload("res://Audio/meow_growl.wav"),
}

const POOL_SIZE = 12

var pool: Array[AudioStreamPlayer] = []


func _ready():
	if AudioServer.get_bus_index("SFX") == -1:
		AudioServer.add_bus()
		AudioServer.set_bus_name(AudioServer.bus_count - 1, "SFX")
		AudioServer.set_bus_send(AudioServer.bus_count - 1, "Master")
	for i in POOL_SIZE:
		var player = AudioStreamPlayer.new()
		player.bus = "SFX"
		add_child(player)
		pool.append(player)
	Game.apply_settings()   # the SFX bus exists now


# ---- MEOWS (playtest 7; both reviewers: "yes, but sparse"). Shmitten meows on character
# moments only - never on shots. At most one meow every MEOW_GLOBAL_COOLDOWN s and the same
# event once every MEOW_EVENT_COOLDOWN s; random variant, +-8% pitch, tuned to the current
# song's key, snapped to the next 8th note if it is within MEOW_SNAP s; mixed under the music.
# Settings -> "Cat meows" turns them off.
const MEOW_GLOBAL_COOLDOWN = 6.0   # go-live review: ~1 meow / 11 s was too chatty
const MEOW_EVENT_COOLDOWN = 8.0
const MEOW_SNAP = 0.06
const MEOW_DB = 4.0   # v0.12 playtest: "I never hear the meows" (was -6)
# root note (MIDI) of each track, as generated by tools/gen_audio.py; meows are tuned to A (57)
const TRACK_ROOT = {"level1": 57, "level2": 50, "level3": 52, "level4": 53, "level5": 55, "level6": 48, "level7": 50, "level8": 53, "boss5": 55, "boss6": 48, "boss7": 50, "boss8": 53, "boss1": 57, "boss2": 50, "boss3": 52, "boss4": 53}
var _last_meow = -100.0
var _last_event = {}


# kind: "cast", "capture", "companion", "hit", "boss_defeat", "mech", "pet"
func meow(kind: String) -> bool:
	if not Game.meows_enabled:
		return false
	var now = Time.get_ticks_msec() / 1000.0
	if kind != "pet":   # petting the cat on the title screen always answers
		if now - _last_meow < MEOW_GLOBAL_COOLDOWN or now - _last_event.get(kind, -100.0) < MEOW_EVENT_COOLDOWN:
			return false
	_last_meow = now
	_last_event[kind] = now
	var sound = {"hit": "mrrp", "mech": "meow_growl"}.get(kind, "meow_%d" % (randi() % 5 + 1))
	var semis = (TRACK_ROOT.get(Conductor.track, 57) - 57)
	semis = wrapi(semis + 6, 0, 12) - 6   # nearest octave of the song's root
	var pitch = pow(2.0, semis / 12.0) * randf_range(0.92, 1.08)
	Game.track("meows")
	# snap to the next 8th note if it's very close, so the meow lands in the groove
	if Conductor.playing:
		var pos = Conductor.beat_position() * 2.0
		var wait = (ceil(pos) - pos) * Conductor.seconds_per_beat / 2.0
		if wait > 0.005 and wait <= MEOW_SNAP:
			get_tree().create_timer(wait, true, false, true).timeout.connect(func(): _play_pitched(sound, pitch))
			return true
	_play_pitched(sound, pitch)
	return true


func _play_pitched(sound_name: String, pitch: float):
	for player in pool:
		if not player.playing:
			player.stream = SOUNDS[sound_name]
			player.volume_db = MEOW_DB
			player.pitch_scale = pitch
			player.play()
			player.finished.connect(func(): player.pitch_scale = 1.0, CONNECT_ONE_SHOT)
			return


func play(sound_name: String, volume_db: float = 0.0):
	if not SOUNDS.has(sound_name):
		push_warning("Unknown sound: %s" % sound_name)
		return
	for player in pool:
		if not player.playing:
			player.stream = SOUNDS[sound_name]
			player.volume_db = volume_db
			player.play()
			return
